    help = {
        action = function(args)
            local category = args[1] and args[1]:lower()
            
            local categories = {
                basic = [[
[ БАЗОВЫЕ КОМАНДЫ ]
help [категория] - показать помощь (например: help files)
clear            - очистить экран
whoami           - показать твой ник и ID
game_info        - показать ID игры и сервера
]],
                files = [[
[ ФАЙЛЫ И ПАПКИ ]
ls [папка]       - показать файлы
cd <папка>       - перейти в папку
pwd              - текущая папка
cat <файл>       - прочитать файл
echo текст > файл - записать текст в файл
mkdir <папка>    - создать папку
touch <файл>     - создать пустой файл
rm <файл>        - удалить файл
exec <файл.lua>  - выполнить скрипт
]],
                players = [[
[ ИГРОКИ ]
players          - список всех игроков
names            - имена всех игроков
playerinfo <ник> - подробная инфа об игроке
infopipl         - HP и позиция всех игроков
teleport <ник>   - телепорт к игроку
tp <ник> или <x y z> - телепорт к игроку/координатам
bring <ник>      - телепорт игрока к тебе
kill <ник>       - убить игрока
]],
                movement = [[
[ ДВИЖЕНИЕ ]
fly              - полет (Space вверх, Shift вниз)
noclip           - проход сквозь стены
speed <число>    - скорость ходьбы (по умол. 16)
jump <число>     - сила прыжка (по умол. 50)
anchor           - заморозить себя
unanchor         - разморозить себя
sit              - сесть
stand            - встать
reset            - убить себя (респавн)
]],
                world = [[
[ МИР И БЛОКИ ]
brk              - удалить блок под прицелом
bld              - поставить блок под прицелом
blockinfo        - инфа о блоке под прицелом
parts            - статистика всех блоков
find <имя>       - найти объект по имени
findclass <класс> - найти объект по классу
modelinfo <имя>  - инфа о модели
]],
                scripts = [[
[ СКРИПТЫ И РЕМОУТЫ ]
scripts          - список всех скриптов
remotes          - список всех RemoteEvent/Function
scan             - краткий список ремоутов
fire <имя> [аргументы] - вызвать RemoteEvent
invoke <имя>     - вызвать RemoteFunction
remoteinfo <имя> - инфа о ремоуте
accheck          - проверить античит
]],
                visual = [[
[ ВИЗУАЛ ]
esp              - подсветить игроков
unesp            - убрать подсветку
antf             - сделать себя невидимым
anfl             - noclip только рядом с игроками
]],
                edit = [[
[ РЕДАКТИРОВАНИЕ МИРА ]
copy_part        - клонировать блок под прицелом
color_part <r> <g> <b> - покрасить блок
move_part <x> <y> <z> - сдвинуть блок
resize_part <x> <y> <z> - изменить размер
delete_part      - удалить блок под прицелом
clone_model <имя> - клонировать модель
delete_model <имя> - удалить модель
]],
                misc = [[
[ ПРОЧЕЕ ]
admin            - открыть админ-панель (Bypass)
crash            - спамить ремоуты (осторожно!)
rejoin           - перезайти на сервер
serverhop        - перейти на другой сервер
srv              - инфа о сервере
ping             - пинг до сервера
save <имя>       - сохранить данные
load <имя>       - загрузить данные
]]
            }

            if category and categories[category] then
                return categories[category]
            end

            return [[Добро пожаловать в xinux!
Для подробной справки напиши: help <категория>
Категории:
 basic    - Базовые команды
 files    - Файлы и папки
 players  - Игроки
 movement - Движение (fly, noclip, speed)
 world    - Мир и блоки
 scripts  - Скрипты и ремоуты
 visual   - Визуал (esp, invisible)
 edit     - Редактирование мира
 misc     - Прочее (admin, crash, rejoin)
]]
        end
    },