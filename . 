<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Roblox Info</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #0e1116;
    color: #e6edf3;
    min-height: 100vh;
  }
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
  }
  header {
    padding: 20px 0;
    text-align: center;
  }
  header h1 {
    margin: 0 0 6px 0;
    font-size: 26px;
  }
  header p {
    margin: 0;
    color: #8b949e;
    font-size: 14px;
  }
  .search {
    display: flex;
    gap: 8px;
    margin: 24px 0;
    flex-wrap: wrap;
  }
  .search input {
    flex: 1;
    min-width: 200px;
    padding: 12px 14px;
    background: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
  }
  .search input:focus { border-color: #58a6ff; }
  .search button {
    padding: 12px 20px;
    background: #238636;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .search button:hover { background: #2ea043; }
  .search button:disabled { opacity: 0.5; cursor: not-allowed; }

  .status {
    padding: 12px;
    background: #161b22;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 14px;
    color: #8b949e;
    display: none;
  }
  .status.show { display: block; }
  .status.error { color: #ff7b72; border: 1px solid #5c1f1f; }

  .card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 14px;
  }
  .profile-head {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: #21262d;
    object-fit: cover;
  }
  .profile-name {
    flex: 1;
    min-width: 180px;
  }
  .profile-name h2 {
    margin: 0 0 4px 0;
    font-size: 20px;
  }
  .profile-name .display {
    color: #8b949e;
    font-size: 14px;
    margin-bottom: 6px;
  }
  .badges-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 6px;
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }
  .badge.ok { background: #1f3d24; color: #3fb950; }
  .badge.ban { background: #5c1f1f; color: #ff7b72; }
  .badge.prem { background: #3d2f1f; color: #d29922; }
  .badge.info { background: #1f2d3d; color: #58a6ff; }

  .row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 14px;
    color: #8b949e;
    margin: 4px 0;
  }
  .row b { color: #e6edf3; }

  .section-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 10px 0;
    color: #e6edf3;
    border-bottom: 1px solid #30363d;
    padding-bottom: 6px;
  }

  .desc {
    background: #0d1117;
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    white-space: pre-wrap;
    word-break: break-word;
    color: #c9d1d9;
    margin-top: 10px;
  }

  .list-item {
    padding: 10px 12px;
    background: #0d1117;
    border-radius: 8px;
    margin-bottom: 6px;
    font-size: 14px;
  }
  .list-item .name { color: #58a6ff; font-weight: 600; }
  .list-item .sub { color: #8b949e; font-size: 12px; margin-top: 2px; }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .avatar { width: 70px; height: 70px; }
  }

  footer {
    text-align: center;
    padding: 30px 0;
    color: #6e7681;
    font-size: 12px;
  }
  a { color: #58a6ff; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Roblox Info</h1>
    <p>Информация по Roblox-аккаунту — профиль, друзья, группы, игры, бейджи</p>
  </header>

  <div class="search">
    <input id="query" placeholder="Введи User ID или никнейм" autocomplete="off">
    <button id="go">Найти</button>
  </div>

  <div id="status" class="status"></div>
  <div id="result"></div>

  <footer>
    Данные из Roblox API. Пароль, email, телефон недоступны.
  </footer>
</div>

<script>
// ============================================================
// ПРОКСИ — обход CORS
// ============================================================
const PROXIES = [
  (u) => "https://api.allorigins.win/raw?url=" + encodeURIComponent(u),
  (u) => "https://corsproxy.io/?" + encodeURIComponent(u),
  (u) => "https://api.codetabs.com/v1/proxy?quest=" + encodeURIComponent(u),
];

async function fetchRoblox(url) {
  let lastErr = null;
  for (const wrap of PROXIES) {
    try {
      const r = await fetch(wrap(url));
      if (!r.ok) { lastErr = new Error("HTTP " + r.status); continue; }
      return await r.json();
    } catch (e) { lastErr = e; }
  }
  throw lastErr || new Error("Все прокси недоступны");
}

async function postRoblox(url, body) {
  let lastErr = null;
  for (const wrap of PROXIES) {
    try {
      const r = await fetch(wrap(url), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      if (!r.ok) { lastErr = new Error("HTTP " + r.status); continue; }
      return await r.json();
    } catch (e) { lastErr = e; }
  }
  throw lastErr || new Error("Все прокси недоступны");
}

// ============================================================
// UI helpers
// ============================================================
const $status = document.getElementById("status");
const $result = document.getElementById("result");

function setStatus(text, isErr) {
  $status.textContent = text;
  $status.className = "status show" + (isErr ? " error" : "");
}
function clearStatus() { $status.className = "status"; }

function esc(s) {
  return String(s ?? "").replace(/[&<>"']/g, c => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  }[c]));
}

function fmtNum(n) {
  if (n === null || n === undefined) return "?";
  return Number(n).toLocaleString("ru-RU");
}

function fmtDate(s) {
  if (!s) return "?";
  return s.slice(0, 10);
}

// ============================================================
// MAIN
// ============================================================
const $btn = document.getElementById("go");
const $input = document.getElementById("query");

$btn.addEventListener("click", run);
$input.addEventListener("keydown", e => { if (e.key === "Enter") run(); });

async function run() {
  const q = $input.value.trim();
  if (!q) return;

  $btn.disabled = true;
  $result.innerHTML = "";
  setStatus("Ищу...");

  try {
    let userId = null;

    // если число — это ID
    if (/^\d+$/.test(q)) {
      userId = parseInt(q, 10);
    } else {
      // иначе — поиск по нику
      setStatus("Ищу по нику...");
      const byName = await postRoblox(
        "https://users.roblox.com/v1/usernames/users",
        { usernames: [q], excludeBannedUsers: false }
      );
      if (!byName.data || byName.data.length === 0) {
        throw new Error("Пользователь не найден");
      }
      userId = byName.data[0].id;
    }

    setStatus("Загружаю профиль...");

    // Параллельные запросы
    const [
      user, avatar, friendsCount, followersCount, followingsCount,
      history, groups, games, badges, presence
    ] = await Promise.all([
      fetchRoblox(`https://users.roblox.com/v1/users/${userId}`).catch(() => null),
      fetchRoblox(`https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=${userId}&size=420x420&format=Png&isCircular=false`).catch(() => null),
      fetchRoblox(`https://friends.roblox.com/v1/users/${userId}/friends/count`).catch(() => null),
      fetchRoblox(`https://friends.roblox.com/v1/users/${userId}/followers/count`).catch(() => null),
      fetchRoblox(`https://friends.roblox.com/v1/users/${userId}/followings/count`).catch(() => null),
      fetchRoblox(`https://users.roblox.com/v1/users/${userId}/username-history?limit=10&sortOrder=Desc`).catch(() => null),
      fetchRoblox(`https://groups.roblox.com/v1/users/${userId}/groups/roles`).catch(() => null),
      fetchRoblox(`https://games.roblox.com/v2/users/${userId}/games?accessFilter=Public&limit=10&sortOrder=Desc`).catch(() => null),
      fetchRoblox(`https://badges.roblox.com/v1/users/${userId}/badges?limit=10&sortOrder=Desc`).catch(() => null),
      postRoblox(`https://presence.roblox.com/v1/presence/users`, { userIds: [userId] }).catch(() => null),
    ]);

    if (!user || !user.id) {
      throw new Error("Профиль не найден");
    }

    // Друзья (список)
    setStatus("Загружаю друзей...");
    const friendsList = await fetchRoblox(
      `https://friends.roblox.com/v1/users/${userId}/friends`
    ).catch(() => null);

    // Обогащаем друзей именами
    let friendsDetailed = [];
    if (friendsList && friendsList.data && friendsList.data.length > 0) {
      const ids = friendsList.data.slice(0, 50).map(f => f.id);
      const names = await postRoblox(
        "https://users.roblox.com/v1/userids",
        { userIds: ids }
      ).catch(() => null);
      const nameMap = {};
      if (names) for (const u of Object.values(names)) nameMap[u.id] = u;
      friendsDetailed = friendsList.data.slice(0, 50).map(f => ({
        id: f.id,
        name: (nameMap[f.id] && nameMap[f.id].name) || ("user_" + f.id),
        display: (nameMap[f.id] && nameMap[f.id].displayName) || ""
      }));
    }

    render({
      userId, user, avatar, friendsCount, followersCount, followingsCount,
      history, groups, games, badges, presence, friendsDetailed
    });

    clearStatus();
  } catch (e) {
    setStatus("Ошибка: " + e.message, true);
  } finally {
    $btn.disabled = false;
  }
}

// ============================================================
// RENDER
// ============================================================
function render(d) {
  const u = d.user;
  const av = (d.avatar && d.avatar.data && d.avatar.data[0] && d.avatar.data[0].imageUrl) || "";

  const banned = u.isBanned;
  const verified = u.hasVerifiedBadge;
  const created = fmtDate(u.created);

  const friendsCount = (d.friendsCount && d.friendsCount.count) ?? "?";
  const followersCount = (d.followersCount && d.followersCount.count) ?? "?";
  const followingsCount = (d.followingsCount && d.followingsCount.count) ?? "?";

  // presence
  let presenceText = "Неизвестно";
  let lastOnline = null;
  if (d.presence && d.presence.userPresences && d.presence.userPresences[0]) {
    const p = d.presence.userPresences[0];
    const map = { 0: "Оффлайн", 1: "Онлайн (сайт)", 2: "В игре", 3: "В Studio" };
    presenceText = map[p.userPresenceType] || "Неизвестно";
    lastOnline = p.lastOnline;
  }

  // history
  const oldNames = (d.history && d.history.data)
    ? d.history.data.map(x => x.name).filter(n => n && n !== u.name).slice(0, 10)
    : [];

  // groups
  const groups = (d.groups && d.groups.data) ? d.groups.data : [];

  // games
  const games = (d.games && d.games.data) ? d.games.data : [];

  // badges
  const badges = (d.badges && d.badges.data) ? d.badges.data : [];

  let html = "";

  // === Профиль ===
  html += `
    <div class="card">
      <div class="profile-head">
        ${av ? `<img class="avatar" src="${esc(av)}" alt="avatar">` : ""}
        <div class="profile-name">
          <h2>${esc(u.displayName || u.name)} ${verified ? "✔" : ""}</h2>
          <div class="display">@${esc(u.name)}</div>
          <div class="badges-row">
            <span class="badge ${banned ? "ban" : "ok"}">${banned ? "ЗАБАНЕН" : "Активен"}</span>
            <span class="badge info">ID: ${u.id}</span>
          </div>
        </div>
      </div>

      <div class="row"><span>Создан: <b>${esc(created)}</b></span></div>
      <div class="row"><span>Присутствие: <b>${esc(presenceText)}</b></span></div>
      ${lastOnline ? `<div class="row"><span>Последний онлайн: <b>${esc(lastOnline)}</b></span></div>` : ""}
      <div class="row">
        <span>Друзей: <b>${fmtNum(friendsCount)}</b></span>
        <span>Подписчиков: <b>${fmtNum(followersCount)}</b></span>
        <span>Подписок: <b>${fmtNum(followingsCount)}</b></span>
      </div>
      ${u.description ? `<div class="desc">${esc(u.description)}</div>` : ""}
      <div class="row" style="margin-top:10px">
        <a href="https://www.roblox.com/users/${u.id}/profile" target="_blank">Профиль на Roblox</a>
      </div>
    </div>
  `;

  // === История ников ===
  if (oldNames.length) {
    html += `
      <div class="card">
        <div class="section-title">История ников</div>
        ${oldNames.map(n => `<div class="list-item">${esc(n)}</div>`).join("")}
      </div>
    `;
  }

  // === Друзья ===
  if (d.friendsDetailed && d.friendsDetailed.length) {
    html += `
      <div class="card">
        <div class="section-title">Друзья (первые ${d.friendsDetailed.length})</div>
        ${d.friendsDetailed.map(f => `
          <div class="list-item">
            <div class="name">${esc(f.display || f.name)}</div>
            <div class="sub">@${esc(f.name)} • ID: ${f.id}</div>
          </div>
        `).join("")}
      </div>
    `;
  }

  // === Группы + Игры ===
  html += `<div class="grid">`;

  if (groups.length) {
    html += `
      <div class="card">
        <div class="section-title">Группы (${groups.length})</div>
        ${groups.slice(0, 20).map(g => {
          const grp = g.group || {};
          const role = g.role || {};
          return `
            <div class="list-item">
              <div class="name">${esc(grp.name || "?")}</div>
              <div class="sub">Роль: ${esc(role.name || "?")}</div>
            </div>
          `;
        }).join("")}
      </div>
    `;
  }

  if (games.length) {
    html += `
      <div class="card">
        <div class="section-title">Игры (${games.length})</div>
        ${games.slice(0, 20).map(g => `
          <div class="list-item">
            <div class="name">${esc(g.name || "?")}</div>
            <div class="sub">Посещений: ${fmtNum(g.placeVisits || 0)}</div>
          </div>
        `).join("")}
      </div>
    `;
  }

  html += `</div>`;

  // === Бейджи ===
  if (badges.length) {
    html += `
      <div class="card">
        <div class="section-title">Бейджи (${badges.length})</div>
        ${badges.slice(0, 20).map(b => `
          <div class="list-item">
            <div class="name">${esc(b.name || "?")}</div>
          </div>
        `).join("")}
      </div>
    `;
  }

  $result.innerHTML = html;
}
</script>
</body>
</html>