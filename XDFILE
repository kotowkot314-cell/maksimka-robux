local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

local MAX_LOG = 300

local captured = {}
local seen = {}

local function addEntry(text, source)
    if not text or #text < 2 then return end
    local key = text
    if seen[key] then return end
    seen[key] = true

    local isRaw = not text:match("^#+$") and not text:match("^%s*$")
    table.insert(captured, {
        text = text,
        time = os.time(),
        raw = isRaw,
        src = source or "?",
    })
    if #captured > MAX_LOG then
        table.remove(captured, 1)
    end
    print("[SNIPER]", isRaw and "RAW" or "FILTERED", "(" .. tostring(source) .. ")", text)
end

local function processText(text, source)
    if not text or #text < 2 then return end
    local isRaw = not text:match("^#+$") and not text:match("^%s*$")
    addEntry(text, source)
end

TextChatService.MessageReceived:Connect(function(message)
    local ok, text = pcall(function() return message.Text end)
    if ok and text then
        processText(text, "MsgRecv")
    end
end)

local hookSource = hookmetamethod or hookfunction
if hookSource and typeof(hookSource) == "function" then
    pcall(function()
        local mt = getrawmetatable(game)
        if mt then
            local old = mt.__index
            setreadonly(mt, false)
            mt.__index = newcclosure(function(self, key)
                local result = old(self, key)
                if key == "Text" and typeof(self) == "Instance" and self:IsA("TextLabel") then
                    pcall(function()
                        processText(result, "Hook")
                    end)
                end
                return result
            end)
            setreadonly(mt, true)
        end
    end)
end

local function scanOldChat()
    local chat = PlayerGui:FindFirstChild("Chat")
    if not chat then return end
    for _, obj in ipairs(chat:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local t = obj.Text
            if t then processText(t, "OldChat") end
        end
    end
end

local function scanNewChat()
    local chatGui = PlayerGui:FindFirstChild("Chat")
    if chatGui then
        for _, obj in ipairs(chatGui:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local t = obj.Text
                if t then processText(t, "NewChat") end
            end
        end
    end
    local core = game:GetService("CoreGui")
    for _, obj in ipairs(core:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local t = obj.Text
            if t then processText(t, "CoreGui") end
        end
    end
end

local frameCounter = 0
RunService.RenderStepped:Connect(function()
    frameCounter = frameCounter + 1
    if frameCounter % 2 == 0 then
        pcall(scanOldChat)
        pcall(scanNewChat)
    end
end)

local function hookContainer(container, tag)
    if not container then return end
    if container:GetAttribute("sniper_" .. tag) then return end
    container:SetAttribute("sniper_" .. tag, true)

    container.DescendantAdded:Connect(function(obj)
        if obj:IsA("TextLabel") then
            task.spawn(function()
                for i = 1, 3 do
                    processText(obj.Text, tag .. "+Child")
                    task.wait(0.001)
                end
            end)
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        local old = PlayerGui:FindFirstChild("Chat")
        if old then hookContainer(old, "old") end

        local core = game:GetService("CoreGui")
        if core then hookContainer(core, "core") end
    end
end)

