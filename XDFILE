local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LP = Players.LocalPlayer
local PlayerGui = LP:WaitForChild("PlayerGui")

local CHECK_RATE = 0.005
local MAX_LOG = 200

local captured = {}
local seen = {}

local function addEntry(text, isRaw)
    if not text or #text < 2 then return end
    if seen[text] then return end
    seen[text] = true

    table.insert(captured, {
        text = text,
        time = os.time(),
        raw = isRaw,
    })
    if #captured > MAX_LOG then
        table.remove(captured, 1)
    end
    print("[CAPTURED]", isRaw and "RAW" or "FILTERED", text)
end

local function scanOnce()
    local chat = PlayerGui:FindFirstChild("Chat", true)
    if not chat then return end

    for _, label in ipairs(chat:GetDescendants()) do
        if label:IsA("TextLabel") then
            local text = label.Text
            if text and #text >= 2 then
                local isRaw = not text:match("^#+$") and not text:match("^%s*$")
                addEntry(text, isRaw)
            end
        end
    end
end

task.spawn(function()
    while task.wait(CHECK_RATE) do
        pcall(scanOnce)
    end
end)

local function hookChat(chat)
    chat.DescendantAdded:Connect(function(obj)
        if obj:IsA("TextLabel") then
            task.wait(0.001)
            local text = obj.Text
            if text and #text >= 2 then
                local isRaw = not text:match("^#+$") and not text:match("^%s*$")
                addEntry(text, isRaw)
            end
        end
    end)
end

task.spawn(function()
    while task.wait(1) do
        local chat = PlayerGui:FindFirstChild("Chat", true)
        if chat and not chat:GetAttribute("hooked_by_sniper") then
            chat:SetAttribute("hooked_by_sniper", true)
            hookChat(chat)
        end
    end
end)

