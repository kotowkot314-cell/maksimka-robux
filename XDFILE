local function refresh()
    for _, child in ipairs(Scroll:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local rawCount = 0
    for _, e in ipairs(captured) do
        if e.raw then rawCount = rawCount + 1 end
    end
    Status.Text = "RAW: " .. rawCount .. " | Всего: " .. #captured

    for i = #captured, 1, -1 do
        local e = captured[i]
        local line = Instance.new("TextLabel")
        line.Size = UDim2.new(1, 0, 0, 0)
        line.AutomaticSize = Enum.AutomaticSize.Y
        line.BackgroundTransparency = 1
        line.TextColor3 = e.raw and Color3.fromRGB(120, 220, 120) or Color3.fromRGB(150, 150, 170)
        line.Font = Enum.Font.Code
        line.TextSize = 13
        line.TextXAlignment = Enum.TextXAlignment.Left
        line.TextWrapped = true

        local prefix = e.raw and "[RAW] " or "[###] "
        local t = os.date("%H:%M:%S", e.time)
        line.Text = prefix .. "[" .. t .. "] (" .. e.src .. ") " .. e.text

        line.Parent = Scroll
    end
end

RunService.RenderStepped:Connect(function()
    if Main.Visible then
        if tick() - (refresh._last or 0) > 0.5 then
            refresh._last = tick()
            refresh()
        end
    end
end)

OpenBtn.MouseButton1Click:Connect(function()
    Main.Visible = not Main.Visible
    if Main.Visible then
        OpenBtn.Visible = false
        refresh()
    else
        OpenBtn.Visible = true
    end
end)

