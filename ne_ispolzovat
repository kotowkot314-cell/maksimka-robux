local CONFIG_FILE = "i_Russicool_config.json"

function F.saveConfig()
    local data = {
        theme = F.theme,
        flySpeed = F.flySpeed,
        flingStrength = F.flingStrength,
        speed = F.speed,
        hitboxSize = F.hitboxSize,
    }
    pcall(function()
        writefile(CONFIG_FILE, http:JSONEncode(data))
    end)
end

function F.loadConfig()
    pcall(function()
        if isfile and isfile(CONFIG_FILE) then
            local data = http:JSONDecode(readfile(CONFIG_FILE))
            F.theme = data.theme or F.theme
            F.flySpeed = data.flySpeed or F.flySpeed
            F.flingStrength = data.flingStrength or F.flingStrength
            F.speed = data.speed or F.speed
            F.hitboxSize = data.hitboxSize or F.hitboxSize
        end
    end)
end

