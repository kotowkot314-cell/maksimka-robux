function F.addEsp(obj, txt, color)
    if not obj or not obj.Parent then return end
    if F.esp[obj] then return end
    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
    if not part then return end

    local hl = Instance.new("Highlight", obj)
    hl.FillColor = color or themes[F.theme].accent
    hl.FillTransparency = 0.5
    hl.OutlineColor = color or themes[F.theme].accent
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local bb = Instance.new("BillboardGui", part)
    bb.Size = UDim2.new(0, 100, 0, 20)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = txt or ""
    lbl.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    lbl.TextStrokeTransparency = 0
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12

    F.esp[obj] = {hl = hl, bb = bb}
end

function F.remEsp(obj)
    if F.esp[obj] then
        pcall(function()
            F.esp[obj].hl:Destroy()
            F.esp[obj].bb:Destroy()
        end)
        F.esp[obj] = nil
    end
end

function F.clearEsp()
    for obj, _ in pairs(F.esp) do
        F.remEsp(obj)
    end
end

function F.flyLoop()
    while F.fly do
        local char = plr.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local move = Vector3.zero
                if uis:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
                if uis:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
                if uis:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
                if uis:IsKeyDown(Enum.KeyCode.LeftShift) then move -= Vector3.new(0,1,0) end

                local bv = hrp:FindFirstChild("i_Russicool_fly") or Instance.new("BodyVelocity", hrp)
                bv.Name = "i_Russicool_fly"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.P = 1250
                bv.Velocity = move * F.flySpeed

                local bg = hrp:FindFirstChild("i_Russicool_gyro") or Instance.new("BodyGyro", hrp)
                bg.Name = "i_Russicool_gyro"
                bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                bg.P = 3000
                bg.CFrame = cam.CFrame
            end
        end
        task.wait()
    end
    local char = plr.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("i_Russicool_fly")
            if bv then bv:Destroy() end
            local bg = hrp:FindFirstChild("i_Russicool_gyro")
            if bg then bg:Destroy() end
        end
    end
end

function F.noclipLoop()
    while F.noclip do
        local char = plr.Character
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end
        task.wait(0.1)
    end
end

function F.speedLoop()
    while F.on do
        local char = plr.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16 + F.speed
                hum.JumpPower = F.jumpPower
            end
        end
        task.wait(0.2)
    end
end

function F.espPlayersLoop()
    while F.on do
        if F.espPlayers then
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= plr and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local myHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and myHrp then
                        local dist = (hrp.Position - myHrp.Position).Magnitude
                        F.addEsp(p.Character, p.Name .. " [" .. math.floor(dist) .. "m]", themes[F.theme].accent)
                    end
                end
            end
        else
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= plr and p.Character then
                    F.remEsp(p.Character)
                end
            end
        end
        task.wait(0.5)
    end
end

function F.autoDriveLoop()
    while F.on do
        if F.autoDrive then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local myHrp = char:FindFirstChild("HumanoidRootPart")
                if hum and myHrp then
                    local closest, closestDist = nil, math.huge
                    for _, p in pairs(game.Players:GetPlayers()) do
                        if p ~= plr and p.Character then
                            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local d = (hrp.Position - myHrp.Position).Magnitude
                                if d < closestDist then
                                    closestDist = d
                                    closest = hrp
                                end
                            end
                        end
                    end
                    if closest and closestDist > 2 then
                        hum:MoveTo(closest.Position)
                    end
                end
            end
        end
        task.wait(0.2)
    end
end

function F.autoFlingLoop()
    while F.on do
        if F.autoFling then
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= plr and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local bv = hrp:FindFirstChild("i_Russicool_autofling") or Instance.new("BodyVelocity", hrp)
                        bv.Name = "i_Russicool_autofling"
                        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                        bv.Velocity = Vector3.new(math.random(-500,500), 500, math.random(-500,500))
                        game:GetService("Debris"):AddItem(bv, 0.5)
                    end
                end
            end
        end
        task.wait(1)
    end
end

function F.infiniteJumpLoop()
    while F.on do
        if F.infiniteJump then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then
                    if uis:IsKeyDown(Enum.KeyCode.Space) then
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

function F.hitboxLoop()
    while F.on do
        if F.hitboxSize > 1 then
            for _, p in pairs(game.Players:GetPlayers()) do
                if p ~= plr and p.Character then
                    for _, part in pairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            part.Size = part.Size * F.hitboxSize
                        end
                    end
                end
            end
        end
        task.wait(2)
    end
end

